{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-main",
  "description": "Permite atajos de teclado (volver al inicio, ajustes, recargar, atras/adelante) desde paginas web navegadas",
  "windows": ["main"],
  "remote": {
    "urls": ["https://*", "http://*"]
  },
  "permissions": [
    "core:default",
    "allow-home",
    "allow-settings",
    "allow-reload",
    "allow-back",
    "allow-forward",
    "allow-ws",
    "allow-wsnew"
  ]
}